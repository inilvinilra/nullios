Screen {
    align: center top;
}

#app-grid {
    width: 100%;
    height: 100%;
}

#sidebar {
    width: 28;
    height: 100%;
    border: round $primary-darken-2;
    background: $surface-darken-1;
    padding: 1 1;
}

#brand {
    text-style: bold;
    color: $accent;
    content-align: center middle;
    height: 3;
    text-align: center;
}

#target_input {
    margin: 1 0;
}

#sidebar Button {
    width: 100%;
    margin: 1 0;
}

#status {
    margin-top: 2;
    color: $text-muted;
    text-style: italic;
}

#workspace {
    width: 1fr;
    height: 100%;
    padding: 1 2;
}

#tabs {
    height: 100%;
    border: round $primary;
    background: $surface;
}

#overview {
    padding: 1 2;
    height: auto;
}

#findings_table, #entitlements_table {
    width: 100%;
    height: 100%;
}

#url_list, #framework_list {
    width: 100%;
    height: 100%;
}

#strings_view {
    width: 100%;
    height: auto;
    padding: 1 2;
}

#log {
    width: 100%;
    height: 100%;
    border: round $primary-darken-1;
    background: $surface-darken-1;
}

TabbedContent:focus {
    border: round $accent;
}
